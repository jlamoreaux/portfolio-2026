---
import Base from "../layouts/Base.astro";
---

<Base title="Page Not Found">
	<section class="py-32">
		<div class="container mx-auto px-4 text-center">
			<h1 class="text-6xl md:text-7xl font-bold mb-4 text-gradient">404</h1>
			<p class="text-xl text-muted-foreground mb-8">
				The page you're looking for doesn't exist.
			</p>
			<a
				href="/"
				class="inline-flex items-center justify-center h-11 px-6 rounded-md bg-primary text-primary-foreground hover:bg-primary/90 font-medium transition-colors"
			>
				Go Home
			</a>
		</div>
	</section>
</Base>

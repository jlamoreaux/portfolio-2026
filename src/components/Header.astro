---
import Icon from "./Icon.astro";
import { getPrimaryNav, getSiteConfig } from "../lib/site";

const [nav, config] = await Promise.all([getPrimaryNav(), getSiteConfig()]);
const name = config?.title ?? "Your Name";
---

<header
	id="site-header"
	class="fixed top-0 left-0 right-0 z-50 bg-background/80 backdrop-blur-md border-b border-border/50 transition-[height] duration-300"
	style="height:5rem"
>
	<div class="container mx-auto px-4 h-full flex items-center justify-between">
		<a href="/" class="flex items-center gap-3">
			<img
				src="/logo.webp"
				alt={name}
				width="120"
				height="40"
				class="h-8 w-auto invert dark:invert-0"
			/>
			<span class="text-xl font-bold">{name}</span>
		</a>

		<nav class="hidden md:flex items-center space-x-8">
			{
				nav.map((item) => (
					<a
						href={item.href}
						target={item.target}
						class="relative text-sm font-medium text-muted-foreground hover:text-foreground transition-colors"
					>
						{item.label}
					</a>
				))
			}
		</nav>

		<div class="flex items-center space-x-2">
			<button
				id="theme-toggle"
				type="button"
				class="inline-flex items-center justify-center h-9 w-9 rounded-md hover:bg-muted transition-colors"
				aria-label="Toggle theme"
			>
				<Icon name="Sun" class="h-4 w-4 hidden dark:block" />
				<Icon name="Moon" class="h-4 w-4 block dark:hidden" />
			</button>
			<button
				id="mobile-menu-btn"
				type="button"
				class="md:hidden inline-flex items-center justify-center h-9 w-9 rounded-md hover:bg-muted transition-colors"
				aria-label="Open menu"
			>
				<Icon name="Menu" class="h-4 w-4" />
			</button>
		</div>
	</div>

	<div
		id="mobile-menu"
		class="md:hidden hidden absolute top-full inset-x-0 border-t border-border/50 bg-background/95 backdrop-blur-md"
	>
		<nav class="container mx-auto px-4 py-4 flex flex-col space-y-4">
			{
				nav.map((item) => (
					<a
						href={item.href}
						target={item.target}
						class="text-lg font-medium text-muted-foreground hover:text-foreground transition-colors"
					>
						{item.label}
					</a>
				))
			}
		</nav>
	</div>
</header>

<script>
	const header = document.getElementById("site-header");
	function onScroll() {
		if (header) header.style.height = window.scrollY > 50 ? "4rem" : "5rem";
	}
	document.addEventListener("scroll", onScroll, { passive: true });
	onScroll();

	document.getElementById("theme-toggle")?.addEventListener("click", () => {
		const isDark = document.documentElement.classList.toggle("dark");
		try {
			localStorage.setItem("theme", isDark ? "dark" : "light");
		} catch {
			/* ignore */
		}
	});

	const menuBtn = document.getElementById("mobile-menu-btn");
	const menu = document.getElementById("mobile-menu");
	menuBtn?.addEventListener("click", () => menu?.classList.toggle("hidden"));
	menu?.querySelectorAll("a").forEach((a) =>
		a.addEventListener("click", () => menu.classList.add("hidden")),
	);
</script>

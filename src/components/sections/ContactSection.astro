---
import Icon from "../Icon.astro";

interface Props {
	config: Record<string, any> | null;
	linkedinHref?: string;
}

const { config, linkedinHref } = Astro.props;
const status = config?.availability_status ?? "available";
const message = config?.availability_message ?? "";
const responseTime = config?.response_time ?? "";
const bestTopics: string[] = config?.best_topics ?? [];
const ctaTitle = config?.contact_cta_title ?? "Let's work together";
const ctaDesc = config?.contact_cta_description ?? "";
const email = config?.email ?? "";
const isAvailable = status === "available";
---

<section id="contact" class="py-20 bg-muted/30">
	<div class="container mx-auto px-4">
		<div class="text-center mb-16">
			<h2 class="text-3xl md:text-4xl font-bold mb-4">Let's Connect</h2>
			<p class="text-xl text-muted-foreground max-w-2xl mx-auto">
				Interested in collaborating or have questions about development? Reach
				out through any of these channels.
			</p>
		</div>

		<div class="max-w-4xl mx-auto">
			<div class="text-center space-y-8">
				<div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-2xl mx-auto">
					<div
						class="rounded-lg border bg-gradient-to-br from-primary/5 to-accent/5 dark:from-transparent dark:to-transparent dark:border-primary/20 p-6 text-center"
					>
						<div class="flex items-center justify-center gap-2 mb-3">
							<div
								class:list={[
									"w-3 h-3 rounded-full animate-pulse",
									isAvailable ? "bg-green-500" : "bg-yellow-500",
								]}
							>
							</div>
							<span class="font-semibold">
								{isAvailable ? "Currently Available" : "Limited Availability"}
							</span>
						</div>
						<p class="text-sm text-muted-foreground">{message}</p>
					</div>

					<div class="rounded-lg border bg-card p-6 text-center">
						<h4 class="font-semibold mb-3">Response Time</h4>
						<p class="text-sm text-muted-foreground">{responseTime}</p>
					</div>
				</div>

				<div class="rounded-lg border bg-card max-w-2xl mx-auto p-6">
					<h4 class="font-semibold mb-4 text-center">
						Best Topics for Discussion
					</h4>
					<div
						class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm text-muted-foreground text-left"
					>
						{
							bestTopics.map((topic, index) => (
								<div class="flex items-center gap-2">
									<div
										class:list={[
											"w-2 h-2 rounded-full",
											index % 2 === 0 ? "bg-primary" : "bg-accent",
										]}
									/>
									<span>{topic}</span>
								</div>
							))
						}
					</div>
				</div>

				<div
					class="bg-gradient-to-r from-primary/10 to-accent/10 dark:from-transparent dark:to-transparent dark:border dark:border-primary/30 rounded-2xl p-8"
				>
					<h3 class="text-2xl font-bold mb-4">{ctaTitle}</h3>
					<p class="text-muted-foreground mb-6 max-w-xl mx-auto">{ctaDesc}</p>
					<div class="flex flex-wrap justify-center gap-4">
						<a
							href={`mailto:${email}`}
							class="inline-flex items-center justify-center h-11 px-6 text-base font-medium rounded-md bg-primary text-primary-foreground hover:bg-primary/90 transition-colors"
						>
							<Icon name="Mail" class="mr-2 h-5 w-5" />
							Send Email
						</a>
						{
							linkedinHref && (
								<a
									href={linkedinHref}
									target="_blank"
									rel="noopener noreferrer"
									class="inline-flex items-center justify-center h-11 px-6 text-base font-medium rounded-md border border-input bg-transparent hover:bg-accent hover:text-accent-foreground transition-colors"
								>
									<Icon name="Linkedin" class="mr-2 h-5 w-5" />
									Connect on LinkedIn
								</a>
							)
						}
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

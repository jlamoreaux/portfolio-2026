---
import AnimatedBackground from "../AnimatedBackground.astro";
import Icon from "../Icon.astro";

interface Props {
	config: Record<string, any> | null;
}

const { config } = Astro.props;
const name = config?.title ?? "Your Name";
const avatar =
	(typeof config?.avatar === "object" ? config?.avatar?.src : config?.avatar) ??
	"/placeholder.svg";
const line1 = config?.hero_title_line1 ?? "Software Developer";
const line2 = config?.hero_title_line2 ?? "& Problem Solver";
const description = config?.hero_description ?? "";
const primaryText = config?.hero_primary_cta ?? "View Projects";
const primaryHref = config?.hero_primary_cta_href ?? "/projects";
const secondaryText = config?.hero_secondary_cta ?? "Read Blog";
const secondaryHref = config?.hero_secondary_cta_href ?? "/blog";
const technologies: string[] = config?.technologies ?? [];
---

<section
	class="relative min-h-screen flex items-center justify-center overflow-hidden"
>
	<AnimatedBackground />

	<div class="container mx-auto px-4 py-20 relative z-10">
		<div class="max-w-4xl mx-auto text-center animate-fade-in">
			<div class="mb-8">
				<div
					class="relative w-32 h-32 mx-auto mb-8 rounded-full overflow-hidden"
				>
					<img
						src={avatar}
						alt={name}
						class="object-cover w-full h-full"
						width="128"
						height="128"
					/>
					<div
						class="absolute inset-0 bg-gradient-to-br from-orange-600/20 to-amber-500/20 opacity-0 hover:opacity-100 transition-opacity duration-300"
					>
					</div>
				</div>
			</div>

			<h1 class="text-4xl md:text-6xl lg:text-7xl font-bold mb-6">
				<span class="block">{line1}</span>
				<span class="block text-gradient">{line2}</span>
			</h1>

			<p
				class="text-xl md:text-2xl text-muted-foreground mb-8 max-w-3xl mx-auto leading-relaxed"
			>
				{description}
			</p>

			<div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
				<a
					href={primaryHref}
					class="group inline-flex items-center justify-center bg-primary hover:bg-primary/90 text-primary-foreground px-8 py-3 text-lg rounded-md font-medium transition-colors"
				>
					{primaryText}
					<Icon
						name="ArrowRight"
						class="ml-2 h-5 w-5 group-hover:translate-x-1 transition-transform"
					/>
				</a>
				<a
					href={secondaryHref}
					class="inline-flex items-center justify-center px-8 py-3 text-lg rounded-md font-medium border border-primary/20 hover:border-primary/40 transition-colors"
				>
					{secondaryText}
				</a>
			</div>

			<div class="mt-16">
				<p class="text-sm text-muted-foreground mb-4">Currently working with</p>
				<div class="flex flex-wrap justify-center gap-6 items-center opacity-60">
					{technologies.map((tech) => <span class="font-mono text-sm">{tech}</span>)}
				</div>
			</div>
		</div>
	</div>
</section>

---
import Icon from "../Icon.astro";
import { USES_CATEGORIES } from "../../lib/site";

interface Props {
	items: Array<Record<string, any>>;
	standalone?: boolean;
}

const { items, standalone = false } = Astro.props;
---

<section
	id={standalone ? undefined : "uses"}
	class:list={["py-20", !standalone && "bg-muted/30"]}
>
	<div class="container mx-auto px-4">
		{
			standalone && (
				<div class="mb-8">
					<a
						href="/"
						class="group inline-flex items-center text-sm font-medium text-muted-foreground hover:text-foreground transition-colors"
					>
						<Icon
							name="ArrowLeft"
							class="h-4 w-4 mr-2 group-hover:-translate-x-1 transition-transform"
						/>
						Back to Home
					</a>
				</div>
			)
		}

		<div class="text-center mb-16">
			<h1
				class:list={[
					standalone ? "text-4xl md:text-5xl" : "text-3xl md:text-4xl",
					"font-bold mb-4",
				]}
			>
				What I Use
			</h1>
			<p class="text-xl text-muted-foreground max-w-2xl mx-auto mb-4">
				{
					standalone
						? "A comprehensive look at the tools, hardware, and software that power my development workflow and daily productivity."
						: "Tools, hardware, and software that power my development workflow"
				}
			</p>
			<p class="text-sm text-muted-foreground">Last updated: January 2024</p>
		</div>

		{
			USES_CATEGORIES.map((cat) => {
				const catItems = items.filter((i) => i.use_category === cat.name);
				if (catItems.length === 0) return null;
				return (
					<div class="mb-16 last:mb-0">
						<div class="flex items-center gap-3 mb-8">
							<div class:list={["p-2 rounded-lg", cat.color]}>
								<Icon name={cat.icon} class="h-6 w-6 text-white" />
							</div>
							<h2 class="text-2xl font-bold">{cat.name}</h2>
							<span class="ml-auto inline-flex items-center rounded-md border border-input px-2.5 py-0.5 text-xs font-medium">
								{catItems.length} item{catItems.length !== 1 ? "s" : ""}
							</span>
						</div>
						<div
							class:list={[
								"grid grid-cols-1 gap-6",
								standalone ? "md:grid-cols-2 xl:grid-cols-3" : "md:grid-cols-2",
							]}
						>
							{catItems.map((item) => (
								<div class="h-full rounded-lg border bg-card text-card-foreground shadow-sm hover:shadow-lg transition-all duration-300 hover:-translate-y-1">
									<div class="p-6 pb-4">
										<div class="flex items-start gap-4">
											<div class="relative w-16 h-16 rounded-lg overflow-hidden bg-muted flex-shrink-0">
												<img
													src={item.featured_image?.src ?? "/placeholder.svg"}
													alt={item.title}
													class="object-cover w-full h-full"
													loading="lazy"
												/>
											</div>
											<div class="flex-1 min-w-0">
												<div class="flex items-start justify-between gap-2">
													<h3 class="text-lg font-semibold leading-tight">
														{item.title}
													</h3>
													{item.price && (
														<span class="inline-flex items-center rounded-md border border-input px-2.5 py-0.5 text-xs font-medium whitespace-nowrap">
															{item.price}
														</span>
													)}
												</div>
												<p class="text-sm text-muted-foreground mt-1">
													{item.description}
												</p>
											</div>
										</div>
									</div>
									<div class="px-6 pb-6 pt-0">
										<p class="text-sm text-muted-foreground mb-4 leading-relaxed">
											<span class="font-medium text-foreground">
												Why I use this:
											</span>{" "}
											{item.reasoning}
										</p>
										{item.url && (
											<a
												href={item.url}
												target="_blank"
												rel="noopener noreferrer"
												class="inline-flex items-center text-sm font-medium hover:text-primary transition-colors"
											>
												Learn More
												<Icon name="ExternalLink" class="ml-2 h-3 w-3" />
											</a>
										)}
									</div>
								</div>
							))}
						</div>
					</div>
				);
			})
		}
	</div>
</section>

<div
	class="absolute inset-0 overflow-hidden pointer-events-none"
	id="hero-bg"
	aria-hidden="true"
>
	<div
		class="absolute top-1/4 left-1/4 w-32 h-32 border border-primary/20 rotate-45 animate-pulse"
	>
	</div>
	<div
		class="absolute bottom-1/4 right-1/4 w-24 h-24 border border-accent/20 rotate-12 animate-pulse"
	>
	</div>
	<div
		class="absolute top-1/2 right-1/3 w-16 h-16 bg-gradient-to-br from-primary/10 to-accent/10 rounded-full animate-float"
	>
	</div>
</div>

<script>
	const bg = document.getElementById("hero-bg");
	if (bg) {
		for (let i = 0; i < 50; i++) {
			const dot = document.createElement("div");
			dot.className = "absolute rounded-full";
			dot.style.background = "hsl(var(--primary) / 0.1)";
			const size = Math.random() * 4 + 1;
			dot.style.width = `${size}px`;
			dot.style.height = `${size}px`;
			dot.style.left = `${Math.random() * 100}%`;
			dot.style.top = `${Math.random() * 100}%`;
			dot.style.animation = `bg-float ${Math.random() * 20 + 10}s ease-in-out infinite`;
			bg.appendChild(dot);
		}
	}
</script>

<style>
	@keyframes bg-float {
		0%,
		100% {
			transform: translateY(0);
			opacity: 0.3;
		}
		50% {
			transform: translateY(-30px);
			opacity: 0.8;
		}
	}
</style>
